# PostgreSQL Connection String (VPS / Coolify Postgres)
# Uses psycopg v3 driver (postgresql+psycopg://) or standard postgresql:// (auto-normalized by config.py)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/realestatedeals

# Local SQLite fallback (uncomment for local testing without Postgres)
# DATABASE_URL=sqlite:///./realestatedeals.db

# Optional PIN protection for write operations (Sync / CSV Import / Notes)
APP_PIN=

# Auto-seed Jacksonville starter dataset on first boot if database is empty
AUTO_SEED=true
